# Copy this file to `.env.local` and fill in your values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored and used by Next.js in development.

# Required for RSVP submissions (server-side only — never expose in the browser).
# Create an integration at https://www.notion.so/my-integrations
# Share your RSVP database with that integration (Full access).
NOTION_TOKEN=

# Optional. Defaults to the database bundled with this project.
# Set this if you recreate the RSVP database in your own Notion workspace.
NOTION_DATABASE_ID=f45df64bcd024ce9a80797a758676ea3
